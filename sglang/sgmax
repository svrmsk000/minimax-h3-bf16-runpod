#!/usr/bin/env bash
### BEGIN INIT INFO
# Provides:          sgmax
# Required-Start:    $local_fs $remote_fs
# Required-Stop:     $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: MiniMax H3 SGLang Diffusion server
### END INIT INFO

set -u

NAME="sgmax"
VENV="${SGLANG_VENV:-/opt/minimax-h3/sglang-venv}"
LAUNCHER="/opt/minimax-h3/sglang/start_minimax_h3_ref2va.sh"
PIDFILE="${SGLANG_PIDFILE:-/run/sgmax.pid}"
LOGFILE="${SGLANG_LOGFILE:-/workspace/runpod-slim/logs/sglang.log}"

is_running() {
  [ -s "$PIDFILE" ] || return 1
  local pid
  pid="$(cat "$PIDFILE" 2>/dev/null)" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\0' ' ' < "/proc/$pid/cmdline" | grep -Fq "$VENV/bin/sglang"
}

do_start() {
  if is_running; then
    echo "$NAME is already running (PID $(cat "$PIDFILE"))."
    return 0
  fi
  rm -f "$PIDFILE"

  if [ ! -x "$VENV/bin/sglang" ]; then
    echo "ERROR: SGLang is not installed at $VENV/bin/sglang." >&2
    return 1
  fi
  if [ ! -x "$LAUNCHER" ]; then
    echo "ERROR: SGLang launcher is missing: $LAUNCHER" >&2
    return 1
  fi

  mkdir -p "$(dirname "$LOGFILE")" "$(dirname "$PIDFILE")"
  echo "Starting MiniMax H3 SGLang; log: $LOGFILE"
  nohup "$LAUNCHER" >>"$LOGFILE" 2>&1 </dev/null &
  local pid=$!
  printf '%s\n' "$pid" > "$PIDFILE"

  sleep 2
  if kill -0 "$pid" 2>/dev/null; then
    echo "$NAME started (PID $pid)."
    return 0
  fi

  echo "ERROR: $NAME exited during startup. Last log lines:" >&2
  tail -n 40 "$LOGFILE" >&2 || true
  rm -f "$PIDFILE"
  return 1
}

do_stop() {
  if ! is_running; then
    rm -f "$PIDFILE"
    echo "$NAME is not running."
    return 0
  fi

  local pid
  pid="$(cat "$PIDFILE")"
  echo "Stopping $NAME (PID $pid)..."
  kill -TERM "$pid" 2>/dev/null || true

  local i
  for i in $(seq 1 30); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PIDFILE"
      echo "$NAME stopped."
      return 0
    fi
    sleep 1
  done

  echo "$NAME did not stop gracefully; sending SIGKILL." >&2
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PIDFILE"
  echo "$NAME stopped."
}

do_status() {
  if is_running; then
    echo "$NAME is running (PID $(cat "$PIDFILE"))."
    echo "Log: $LOGFILE"
    return 0
  fi
  rm -f "$PIDFILE"
  echo "$NAME is not running."
  return 3
}

case "${1:-}" in
  start)   do_start ;;
  stop)    do_stop ;;
  status)  do_status ;;
  restart|force-reload)
    do_stop
    do_start
    ;;
  *)
    echo "Usage: service sgmax {start|stop|restart|status}" >&2
    exit 2
    ;;
esac
